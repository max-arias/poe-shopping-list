{
  "name": "poe-shopping-list",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "ext": "vp run --filter @poe-sl/extension dev",
    "ext:build": "vp run --filter @poe-sl/extension build",
    "ext:zip": "vp run --filter @poe-sl/extension zip",
    "ext:check": "vp run --filter @poe-sl/extension check",
    "ext:typecheck": "vp run --filter @poe-sl/extension typecheck",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "typecheck": "npm run ext:typecheck",
    "web:sync": "pnpm --filter @poe-sl/web sync",
    "web:check": "pnpm --filter @poe-sl/web check",
    "web:content:validate": "pnpm --filter @poe-sl/web content:validate",
    "web:test": "pnpm --filter @poe-sl/web test:focused",
    "web:build": "pnpm --filter @poe-sl/web build",
    "web:preview": "pnpm --filter @poe-sl/web preview",
    "web:output:check": "pnpm --filter @poe-sl/web output:check",
    "web:links:check": "pnpm --filter @poe-sl/web links:check",
    "web:test:fixtures:build": "pnpm --filter @poe-sl/web build:test-fixtures",
    "web:test:browser": "pnpm --filter @poe-sl/web test:browser",
    "cf:build": "pnpm --filter @poe-sl/web run build",
    "cf:deploy": "pnpm --filter @poe-sl/web run deploy",
    "cf:deploy:preview": "pnpm --filter @poe-sl/web run deploy:preview"
  },
  "dependencies": {
    "@webext-core/messaging": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite-plus": "0.2.6"
  },
  "packageManager": "pnpm@10.28.0"
}
