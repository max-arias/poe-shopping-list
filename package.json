{
  "name": "poe-shopping-list",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ext": "vp run --filter @poe-sl/extension dev",
    "ext:build": "vp run --filter @poe-sl/extension build",
    "ext:zip": "vp run --filter @poe-sl/extension zip",
    "ext:check": "vp run --filter @poe-sl/extension check",
    "ext:typecheck": "vp run --filter @poe-sl/extension typecheck",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "typecheck": "vp run --filter @poe-sl/extension typecheck",
    "web:dev": "vp run --filter @poe-sl/web dev",
    "web:sync": "vp run --filter @poe-sl/web sync",
    "web:check": "vp run --filter @poe-sl/web check",
    "web:content:validate": "vp run --filter @poe-sl/web content:validate",
    "web:build": "vp run --filter @poe-sl/web build",
    "web:preview": "vp run --filter @poe-sl/web preview",
    "web:output:check": "vp run --filter @poe-sl/web output:check",
    "web:links:check": "vp run --filter @poe-sl/web links:check",
    "cf:build": "vp run --filter @poe-sl/web build",
    "cf:deploy": "vp run --filter @poe-sl/web deploy",
    "cf:deploy:preview": "vp run --filter @poe-sl/web deploy:preview"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite-plus": "0.2.6"
  },
  "packageManager": "pnpm@10.28.0"
}
