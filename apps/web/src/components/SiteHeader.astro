---
interface Props {
  /** Which primary route this page is, so the nav can mark it current. */
  active: "lists" | "crafts";
}

const { active } = Astro.props;
---

<header class="border-b border-field-line">
  <div class="site-shell flex min-h-18 items-center gap-4 max-two:flex-wrap max-two:gap-y-3 max-two:py-3">
    <a
      class="text-[1.625rem] font-bold tracking-[-0.02em] whitespace-nowrap text-field-ink no-underline max-two:text-[1.375rem]"
      href="/">PoE Shopping List</a>
    <nav class="flex items-center gap-5" aria-label="Primary navigation">
      <a
        class="text-base font-medium text-field-muted no-underline hover:text-field-ink aria-[current=page]:font-semibold aria-[current=page]:text-field-ink aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[12px] max-two:ms-auto"
        href="/"
        aria-current={active === "lists" ? "page" : undefined}>Lists</a>
      <a
        class="text-base font-medium text-field-muted no-underline hover:text-field-ink aria-[current=page]:font-semibold aria-[current=page]:text-field-ink aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[12px]"
        href="/crafts/"
        aria-current={active === "crafts" ? "page" : undefined}>Craft notes</a>
    </nav>
    <form class="relative min-w-0 flex-[0_1_340px] ms-auto max-two:flex-[1_1_100%] max-two:order-3" role="search" action="/" method="get">
      <label class="sr-only" for="site-search-input">Search published lists</label>
      <svg
        class="pointer-events-none absolute start-3.25 top-1/2 -translate-y-1/2 text-field-faint"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        aria-hidden="true"
        focusable="false"
      >
        <circle
          cx="11"
          cy="11"
          r="6.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"></circle>
        <path
          d="m16 16 4.5 4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
      <input
        class="min-h-10 w-full rounded-field border border-field-line-strong bg-field-surface py-2 ps-10 pe-3.5 text-base text-field-ink placeholder:text-field-faint hover:border-field-muted focus-visible:border-field-ink"
        id="site-search-input"
        type="search"
        name="q"
        placeholder="Search lists…"
        autocomplete="off"
      />
    </form>
  </div>
</header>
