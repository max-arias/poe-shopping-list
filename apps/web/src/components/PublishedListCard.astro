---
import type { PublishedItem, PublishedList } from "../domain/schemas";
import OverviewMarkdown from "./OverviewMarkdown.astro";

interface Props {
  id: string;
  list: PublishedList;
  exportToken: string;
  lastReviewed?: string;
}

interface RawSection {
  title?: unknown;
  name?: unknown;
  label?: unknown;
  items?: unknown;
}

interface NormalizedSection {
  title: string;
  items: PublishedItem[];
}

const { id, list, exportToken } = Astro.props;
const exportText = `${exportToken}\n`;

// Published content may arrive as either ordered sections or a flat item list.
// Keeping this boundary here lets the renderer stay simple while old flat lists
// continue to have the same appearance.
const rawSections: RawSection[] | undefined = "groups" in list ? list.groups as RawSection[] : undefined;
const flatItems = "items" in list ? list.items : [];

const sections: NormalizedSection[] = rawSections
  ? rawSections
      .map((section) => ({
        title: typeof section.title === "string" ? section.title : typeof section.name === "string" ? section.name : typeof section.label === "string" ? section.label : "",
        items: Array.isArray(section.items) ? section.items as PublishedItem[] : [],
      }))
      .filter((section) => section.items.length > 0)
  : [{ title: "", items: flatItems }];

const hasMultipleSections = sections.length > 1;
const sectionLabel = (section: NormalizedSection, index: number) => section.title || `Section ${index + 1}`;
---

<article id={`list-${id}`} class="manual-entry" data-export={exportToken}>
  <details class="collapse collapse-arrow" open>
    <summary class="list-title collapse-title">
    <span class="list-number" aria-hidden="true">—</span>
    <span role="heading" aria-level="4">{list.title}</span>
    </summary>
    <div class="list-actions-inline" aria-label={`${list.title} export actions`}>
      <a href={`data:application/json;charset=utf-8,${encodeURIComponent(exportText)}`} download={`${list.title.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "published-list"}-shareable-list-v1.json`} data-download aria-label={`Download ${list.title} as JSON`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M12 3v12m-5-5 5 5 5-5M5 21h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <button type="button" data-copy aria-label={`Copy ${list.title} as JSON`}>
        <span class="copy-icon-stack" aria-hidden="true">
          <span class="copy-icon copy-icon--default">
            <svg viewBox="0 0 24 24" width="16" height="16" focusable="false">
              <rect x="9" y="9" width="10" height="10" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M15 9V6a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <span class="copy-icon copy-icon--success">
            <svg viewBox="0 0 24 24" width="16" height="16" focusable="false">
              <path d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </span>
      </button>
    </div>
    <div class="collapse-content">
  {list.overview && <OverviewMarkdown value={list.overview} />}

  <div class="groups" aria-label={`${list.title} groups`}>
    {sections.map((section, sectionIndex) => (hasMultipleSections || section.title) ? <details class="list-group collapse collapse-arrow" open={sectionIndex === 0}>
      <summary class="group-heading collapse-title">
        <span class="group-number" aria-hidden="true">{String(sectionIndex + 1).padStart(2, "0")}</span>
        <span role="heading" aria-level="5">{sectionLabel(section, sectionIndex)}</span>
      </summary>
      <div class="collapse-content">
        <ol class="items" aria-label={`${section.title || list.title} items`}>
          {section.items.map((item, itemIndex) => <li>
            <span class="item-number" aria-hidden="true">{String(itemIndex + 1).padStart(2, "0")}</span>
            <span class="item-copy">
              <a class="item-title" href={item.tradeUrl} target="_blank" rel="noopener noreferrer">{item.title}<span class="visually-hidden"> on Path of Exile Trade</span></a>
              {item.variant && <span class="variant">{item.variant}</span>}
            </span>
          </li>)}
        </ol>
      </div>
    </details> : <section class="list-group">
      <ol class="items" aria-label={`${section.title || list.title} items`}>
        {section.items.map((item, itemIndex) => <li>
          <span class="item-number" aria-hidden="true">{String(itemIndex + 1).padStart(2, "0")}</span>
          <span class="item-copy">
            <a class="item-title" href={item.tradeUrl} target="_blank" rel="noopener noreferrer">{item.title}<span class="visually-hidden"> on Path of Exile Trade</span></a>
            {item.variant && <span class="variant">{item.variant}</span>}
          </span>
        </li>)}
      </ol>
    </section>)}
  </div>
    </div>
  </details>
</article>
