---
import "../styles/theme.css";
import "../styles/crafts.css";

const canonicalUrl = "/crafts/";
---

<!doctype html>
<html lang="en" data-theme="lofi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Crafting Guides | Curated Path of Exile Lists</title>
    <meta name="description" content="Fast, reliable Path of Exile crafting guides for a Divine Life Flask and Large Elemental Cluster Jewel." />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600&display=swap" />
  </head>
  <body class="font-sans">
    <header class="craft-header">
      <nav class="craft-nav" aria-label="Primary navigation">
        <a class="craft-back-link" href="/">← Shopping lists</a>
        <span class="craft-nav-label" aria-current="page">Field notes</span>
      </nav>
    </header>

    <a class="skip-link" href="#craft-main">Skip to the craft notes</a>
    <main id="craft-main" class="craft-main">
      <article class="craft-guide" aria-labelledby="life-flask-title">
        <header class="craft-section-heading">
          <p class="craft-section-number">01</p>
          <h2 id="life-flask-title">Divine Life Flask</h2>
        </header>

        <div class="craft-summary" aria-label="Divine Life Flask summary">
          <span><strong>Cost</strong> 30c</span>
          <span><strong>Method</strong> Magic spam</span>
          <span><strong>Finish</strong> Beast craft</span>
        </div>

        <ol class="craft-steps">
          <li>Spam the flask while it is Magic until it has <strong>instant recovery</strong> or <strong>instant recovery when on low life</strong>.</li>
          <li>Use the Beast craft to grant <strong>immunity to bleeding</strong>.</li>
        </ol>
      </article>

      <article class="craft-guide" aria-labelledby="cluster-title">
        <header class="craft-section-heading">
          <p class="craft-section-number">02</p>
          <h2 id="cluster-title">Large Cluster Jewel</h2>
        </header>

        <p class="craft-action"><a class="craft-trade-link" href="https://www.pathofexile.com/trade/search/Allflame/2Kzk6yVVIk" target="_blank" rel="noopener noreferrer">Open the official Large Cluster Jewel trade search</a></p>

        <div class="craft-block">
          <h3>Start with the right base</h3>
          <ul class="craft-list">
            <li><strong>Item level 68+</strong></li>
            <li><strong>Large Cluster Jewel</strong></li>
            <li><strong>8 passives</strong></li>
            <li><strong>Increased Elemental Damage</strong></li>
          </ul>
        </div>

        <div class="craft-block">
          <h3>Desirable notables</h3>
          <p>Roll for one of these four: <strong>Disorienting Display</strong>, <strong>Doryani's Lesson</strong>, <strong>Prismatic Heart</strong>, or <strong>Sadist</strong>.</p>
          <div class="regex-helper" aria-labelledby="regex-helper-title">
            <p id="regex-helper-title"><strong>Inventory / stash search</strong> Paste this into PoE’s search with regex mode enabled.</p>
            <div class="regex-line">
              <code id="cluster-regex">Disorienting Display|Doryani's Lesson|Prismatic Heart|Sadist</code>
              <button type="button" data-copy-regex aria-describedby="regex-status">Copy regex</button>
            </div>
            <span id="regex-status" class="regex-status" role="status" aria-live="polite"></span>
          </div>
        </div>

        <div class="craft-routes">
          <section class="craft-route" aria-labelledby="two-mod-title">
            <h3 id="two-mod-title">If you have two desirable mods while Magic</h3>
            <ol class="craft-steps">
              <li>Use the Allflame craft for <strong>Regal + Exalt</strong>.</li>
              <li>Seek one of the two desirable notables still missing.</li>
            </ol>
          </section>

          <section class="craft-route" aria-labelledby="one-mod-title">
            <h3 id="one-mod-title">If you have one desirable mod while Magic</h3>
            <ol class="craft-steps">
              <li>Use a regular <strong>Regal</strong> and hope it adds the second desirable mod.</li>
              <li>Use the Allflame <strong>Exalt</strong> and seek one of the two desirable notables still missing.</li>
            </ol>
          </section>
        </div>

        <p class="craft-skip"><strong>Skip:</strong> Widespread Destruction, Corrosive Elements, and Inspired Oppression.</p>
        <aside class="craft-warning" aria-label="Large Cluster Jewel warnings">
          <p><strong>Warning:</strong> This craft can take many Dead Coins.</p>
          <p><strong>Check:</strong> Watch <strong>% Intangibility</strong> before committing more currency.</p>
        </aside>
      </article>
    </main>
    <script>
      const regexButton = document.querySelector<HTMLButtonElement>("[data-copy-regex]");
      const regex = document.querySelector<HTMLElement>("#cluster-regex");
      const regexStatus = document.querySelector<HTMLElement>("#regex-status");
      regexButton?.addEventListener("click", async () => {
        if (!regex || !regexStatus) return;
        const value = regex.textContent || "";
        try {
          if (!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
          await navigator.clipboard.writeText(value);
          regexButton.textContent = "Copied";
          regexStatus.textContent = "Regex copied.";
        } catch {
          const selection = window.getSelection();
          const range = document.createRange();
          range.selectNodeContents(regex);
          selection?.removeAllRanges();
          selection?.addRange(range);
          regexButton.textContent = "Select and copy";
          regexStatus.textContent = "Copy failed. Select the expression and copy it manually.";
        }
      });
    </script>
</body>
</html>
